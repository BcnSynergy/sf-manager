// Prisma schema — infrastructure-layer artifact only (ADR-013). Models are
// added per SDD slice, mapped to hand-written domain entities in each
// module's repository implementations, never used directly outside
// infrastructure/persistence/**.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// design.md Decision 4/9: no `@default` — a required column added to a
// non-empty table needs an explicit backfill, not a schema-level default
// that would silently decide every future insert's role too.
enum Role {
  SYSTEM_ADMIN
  MANAGER
  MAINTENANCE_COMPANY_MANAGER
  MAINTENANCE_TECHNICIAN
  COMMUNITY_REPRESENTATIVE
}

model User {
  id           String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  email        String    @unique // stored lowercase-normalized
  passwordHash String
  role         Role // design.md Decision 9 — no @default, see migration
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // ADR-010
}

// Deny-list, not a session table: only ever holds explicitly logged-out
// tokens until their natural expiry (design.md Decision 9 — minimum viable
// revocation, not general session management).
model RevokedToken {
  jti       String   @id @db.Uuid // the token's own jti claim
  expiresAt DateTime // copied from the token's own exp — safe to delete once past

  // The opportunistic cleanup query (`WHERE expiresAt < now()`) runs on every
  // login/logout, so this must not be a full table scan.
  @@index([expiresAt])
}

// community/design.md Decision 5: closed enum, mirroring `Role`'s
// precedent — no i18n behavior implemented for it in this slice.
enum Locale {
  en
  es
  ca
}

// community/proposal.md Settled decisions: entity shape is exactly
// id, name, address, locale, deletedAt — no `contactInfo` (superseded by
// the assignment lists), no createdAt/updatedAt (not needed by this slice,
// ADR-006 walking-skeleton discipline).
model Community {
  id        String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  name      String
  address   String
  locale    Locale
  deletedAt DateTime? // ADR-010
}

// community/design.md Decision 1: two physically separate tables, not one
// table with a `type` discriminator — the exclusivity invariant applies to
// representatives only, and a shared table would blur that asymmetry.
//
// community/design.md Decision 3: `deactivatedAt`, not `deletedAt` — this
// is domain state ("stopped serving"), not an administrative delete, so it
// must not hide behind `SoftDeletableRepository`'s default filter.
// Reactivation is `deactivatedAt = NULL`; no assignment history is kept.
//
// community/design.md Decision 4: `(communityId, userId)` is the
// caller-facing identity — one row per pair, enforced by `@@unique` below.
// The surrogate `id` never leaves the persistence adapter.
model CommunityRepresentative {
  id            String    @id @db.Uuid
  communityId   String    @db.Uuid
  userId        String    @db.Uuid
  deactivatedAt DateTime? // NULL = active

  // Backstop for the one-active-representative-per-community invariant is a
  // HAND-WRITTEN partial unique index on (communityId) WHERE deactivatedAt
  // IS NULL — Prisma's `@@unique` has no `WHERE` clause, so it cannot be
  // expressed here. See migration.sql (design.md Decision 2 Gotcha).
  @@unique([communityId, userId])
}

// community/design.md: technician sibling of CommunityRepresentative,
// deliberately missing the exclusivity index — many active technicians per
// community, and the same technician active across many communities, is
// allowed with no warning.
model CommunityTechnician {
  id            String    @id @db.Uuid
  communityId   String    @db.Uuid
  userId        String    @db.Uuid
  deactivatedAt DateTime? // NULL = active

  @@unique([communityId, userId])
}
