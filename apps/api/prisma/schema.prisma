// Prisma schema — infrastructure-layer artifact only (ADR-013). Models are
// added per SDD slice, mapped to hand-written domain entities in each
// module's repository implementations, never used directly outside
// infrastructure/persistence/**.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// design.md Decision 4/9: no `@default` — a required column added to a
// non-empty table needs an explicit backfill, not a schema-level default
// that would silently decide every future insert's role too.
enum Role {
  SYSTEM_ADMIN
  MANAGER
  MAINTENANCE_COMPANY_MANAGER
  MAINTENANCE_TECHNICIAN
  COMMUNITY_REPRESENTATIVE
}

model User {
  id                   String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  email                String    @unique // stored lowercase-normalized
  passwordHash         String
  role                 Role // design.md Decision 9 — no @default, see migration
  // maintenance-company/design.md Decision 4/5: nullable — required only for
  // the 2 maintenance roles (app-layer policy + Zod, not a DB CHECK). The FK
  // to MaintenanceCompany(id) is hand-written in migration.sql, INVISIBLE to
  // Prisma (no `@relation` here, ADR-013 — see MaintenanceCompany's comment
  // block below for the full warning).
  maintenanceCompanyId String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime? // ADR-010

  // Prisma-VISIBLE regular index (not the partial unique one — that lives
  // only on MaintenanceCompany.taxId). Postgres does not auto-index FK
  // columns, and countActiveByMaintenanceCompany filters on exactly this
  // column on every delete attempt (maintenance-company/design.md Decision 4).
  @@index([maintenanceCompanyId])
}

// Deny-list, not a session table: only ever holds explicitly logged-out
// tokens until their natural expiry (design.md Decision 9 — minimum viable
// revocation, not general session management).
model RevokedToken {
  jti       String   @id @db.Uuid // the token's own jti claim
  expiresAt DateTime // copied from the token's own exp — safe to delete once past

  // The opportunistic cleanup query (`WHERE expiresAt < now()`) runs on every
  // login/logout, so this must not be a full table scan.
  @@index([expiresAt])
}

// community/design.md Decision 5: closed enum, mirroring `Role`'s
// precedent — no i18n behavior implemented for it in this slice.
enum Locale {
  en
  es
  ca
}

// community/proposal.md Settled decisions: entity shape is exactly
// id, name, address, locale, deletedAt — no `contactInfo` (superseded by
// the assignment lists), no createdAt/updatedAt (not needed by this slice,
// ADR-006 walking-skeleton discipline).
model Community {
  id        String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  name      String
  address   String
  locale    Locale
  deletedAt DateTime? // ADR-010
}

// community/design.md Decision 1: two physically separate tables, not one
// table with a `type` discriminator — the exclusivity invariant applies to
// representatives only, and a shared table would blur that asymmetry.
//
// community/design.md Decision 3: `deactivatedAt`, not `deletedAt` — this
// is domain state ("stopped serving"), not an administrative delete, so it
// must not hide behind `SoftDeletableRepository`'s default filter.
// Reactivation is `deactivatedAt = NULL`; no assignment history is kept.
//
// community/design.md Decision 4: `(communityId, userId)` is the
// caller-facing identity — one row per pair, enforced by `@@unique` below.
// The surrogate `id` never leaves the persistence adapter.
model CommunityRepresentative {
  id            String    @id @db.Uuid
  communityId   String    @db.Uuid
  userId        String    @db.Uuid
  deactivatedAt DateTime? // NULL = active

  // Backstop for the one-active-representative-per-community invariant is a
  // HAND-WRITTEN partial unique index on (communityId) WHERE deactivatedAt
  // IS NULL — Prisma's `@@unique` has no `WHERE` clause, so it cannot be
  // expressed here. See migration.sql (design.md Decision 2 Gotcha).
  @@unique([communityId, userId])
}

// community/design.md: technician sibling of CommunityRepresentative,
// deliberately missing the exclusivity index — many active technicians per
// community, and the same technician active across many communities, is
// allowed with no warning.
model CommunityTechnician {
  id            String    @id @db.Uuid
  communityId   String    @db.Uuid
  userId        String    @db.Uuid
  deactivatedAt DateTime? // NULL = active

  @@unique([communityId, userId])
}

// maintenance-company/design.md Decision 3: all plain fields, no Value
// Objects — see design.md for the per-field re-derivation (name/contactInfo
// have no behaviour beyond validation; taxId's uniqueness is a set property,
// not intrinsic to the value).
//
// maintenance-company/design.md Decision 2: the taxId-unique-among-active-
// companies invariant is enforced ONLY by a HAND-WRITTEN partial unique
// index — `CREATE UNIQUE INDEX ... ON "MaintenanceCompany"("taxId") WHERE
// "deletedAt" IS NULL` — which Prisma's schema DSL cannot express (`@@unique`
// has no `WHERE` clause) and is therefore INVISIBLE to Prisma's migration
// diffing. Same for the FK from User.maintenanceCompanyId to this table's
// id (no `@relation` field here, ADR-013 — mirroring CommunityRepresentative
// above).
//
// WARNING: do NOT let `prisma migrate dev`/`migrate reset` regenerate the
// migration file or diff schema.prisma against the database in a way that
// could DROP that index or FK — Prisma has no knowledge of either. Guarded
// by an integration test asserting their continued presence (see
// migration.sql and the pg_indexes/pg_constraint integration spec).
model MaintenanceCompany {
  id          String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  name        String
  taxId       String // stored upper-cased-normalized (design.md Decision 3)
  contactInfo String
  deletedAt   DateTime? // ADR-010
}

// inspectable-elements/design.md Decision 1: the TypeScript union in
// `domain/element-type.ts` is authoritative; this enum is its persistence
// projection only, mirroring `Role`/`Locale`'s precedent. A parity
// integration spec (Phase 6) asserts this enum, the domain union and the
// Zod schema all agree.
enum ElementType {
  EXTINGUISHER
}

// inspectable-elements/design.md: entity shape is exactly id, communityId,
// elementType, name, description?, location, serialNumber?, installedAt,
// deletedAt — no `code`/`imageUrl`/typed details/hydrostatic tracking
// (ADR-006 walking-skeleton discipline, proposal Settled decisions).
//
// inspectable-elements/design.md Decision 2: name/location/description/
// serialNumber are all plain fields — none carries behaviour beyond
// validation (no Value Objects).
//
// inspectable-elements/design.md Decision 3: `installedAt` is a Postgres
// `DATE`, not `TIMESTAMP(3)` — the first calendar date a human types in
// this schema, transported as ISO `YYYY-MM-DD`. A `TIMESTAMP(3)` would
// round-trip a day off in a non-UTC browser.
//
// The FK to Community(id) is hand-written in migration.sql, INVISIBLE to
// Prisma (no `@relation` here, ADR-013 — mirroring every other
// cross-module FK in this schema: User.maintenanceCompanyId,
// CommunityRepresentative/CommunityTechnician.communityId).
model InspectableElement {
  id           String      @id @db.Uuid // UUIDv7 from the app (ADR-009)
  communityId  String      @db.Uuid
  elementType  ElementType
  name         String
  description  String?
  location     String
  serialNumber String?
  installedAt  DateTime    @db.Date // design.md Decision 3 — DATE, not TIMESTAMP(3)
  deletedAt    DateTime? // ADR-010

  // label-printing/design.md Decision 1-2 + Decision 4: application-generated
  // public identifier, `VARCHAR(10)` not `CHAR(10)` (blank-padded comparison
  // would make 'ABC       ' equal 'ABC'). Backfilled by a hand-written
  // migration (index created before backfill, NOT NULL applied last) — this
  // `@unique` is Prisma-visible and its index name
  // (`InspectableElement_code_key`) is reproduced verbatim in that migration.
  // No @default: the PR1-only transitional DB-generated default (design.md
  // Decision 4a) was dropped by PR3's cleanup migration
  // (20260904150000_drop_inspectable_element_code_bridge) once the real
  // application-level generator (RandomElementCodeGenerator, bounded
  // 3-attempt retry in CreateInspectableElementUseCase) was wired — every
  // real INSERT now always supplies an explicit code.
  code         String      @unique @db.VarChar(10)

  // review-session/design.md Decision 3: `deactivatedAt`, not `deletedAt` —
  // domain state (decommissioned), orthogonal to the administrative delete
  // above. NULL = active. No default, no backfill needed: ADD COLUMN leaves
  // every existing row NULL (active) by construction.
  deactivatedAt DateTime?

  // Prisma-VISIBLE regular index. Postgres does not auto-index FK columns,
  // and every list query plus the community delete guard's NOT EXISTS
  // (design.md Decision 6) filters on exactly this column.
  @@index([communityId])
}

// checklist-management/design.md Decision 1: the TypeScript union in
// `checklist-question/domain/review-frequency.ts` is authoritative; this
// enum is its persistence projection only, mirroring `ElementType`'s
// precedent. A parity integration spec (PR4) asserts this enum, the domain
// union and the Zod schema all agree.
enum ReviewFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// checklist-management/design.md: global admin content pool, not
// community-scoped — flat `/checklist-questions` routes, no community FK.
// Entity shape is exactly id, elementType, frequencies, text, deletedAt —
// no help text, no RIPCI clause reference, no required/optional flag, no
// pool-level `order`, no separate `active` retire flag (deferred;
// `deletedAt` is the sole off state, ADR-010).
//
// checklist-management/design.md Decision 1: `frequencies` is a Postgres
// enum ARRAY, not a join table — a tag set with no attributes of its own,
// always read whole.
model ChecklistQuestion {
  id          String            @id @db.Uuid // UUIDv7 from the app (ADR-009)
  elementType ElementType
  frequencies ReviewFrequency[]
  text        String // admin free text, rendered verbatim, never t()
  deletedAt   DateTime? // ADR-010
}

// checklist-management/design.md Decision 1: the TypeScript union in
// `review-template/domain/review-template-status.ts` is authoritative; this
// enum is its persistence projection only, mirroring `ReviewFrequency`'s
// precedent. A parity integration spec (PR9) asserts this enum, the domain
// union and the Zod schema all agree.
enum ReviewTemplateStatus {
  draft
  active
  retired
}

// checklist-management/design.md Decision 2/3: `version` is NULL until
// activation (COALESCE(MAX(version),0)+1, assigned inside the activation
// transaction) — a discarded draft consumes no version number, which is why
// the lineage-version unique index below tolerates many NULLs. `deletedAt`
// applies to drafts only; frozen (active/retired) versions are undeletable.
//
// checklist-management/design.md Decision 2: `draftQuestionIds` is the
// DRAFT-ONLY, ordered, live selection — an array of ChecklistQuestion ids,
// NEVER the audit record. Reset to '{}' inside the activation transaction.
// No FK on the array elements (Postgres cannot FK an array element);
// acceptable because pool rows are never hard-deleted (ADR-010).
//
// checklist-management/design.md Decision 3: the one-active-per-lineage and
// one-draft-per-lineage invariants are enforced by TWO HAND-WRITTEN PARTIAL
// UNIQUE INDEXES (`@@unique` has no `WHERE` clause, so Prisma cannot express
// them) plus a third hand-written unique index on (elementType, frequency,
// version) for the lineage-version rule. All three are INVISIBLE to Prisma's
// migration diffing — see migration.sql and the pg_indexes integration spec.
//
// WARNING: do NOT let `prisma migrate dev`/`migrate reset` regenerate this
// migration file or diff schema.prisma against the database in a way that
// could DROP any of the three indexes above, or the six pre-existing
// hand-written FKs/indexes from earlier migrations — Prisma has no knowledge
// of any of them.
model ReviewTemplate {
  id               String               @id @db.Uuid // UUIDv7 from the app (ADR-009)
  elementType      ElementType
  frequency        ReviewFrequency
  name             String
  version          Int? // NULL until activation (Decision 3)
  status           ReviewTemplateStatus
  draftQuestionIds String[]             @db.Uuid
  createdAt        DateTime             @default(now())
  deletedAt        DateTime? // drafts only; frozen versions are undeletable
}

// checklist-management/design.md Decision 2: rows exist ONLY for
// activated/retired versions. `questionText` is NOT NULL, so "frozen version
// with no snapshot" is structurally unrepresentable — not test-guarded.
// `questionId` is PROVENANCE ONLY — never the source of displayed wording;
// the frozen read path (design.md Decision 5) does not join ChecklistQuestion
// at all.
//
// The FK from `templateId` to ReviewTemplate(id) is hand-written in
// migration.sql, INVISIBLE to Prisma (no `@relation` here, ADR-013 —
// mirroring every other cross-module FK in this schema).
model ReviewTemplateQuestion {
  id           String @id @db.Uuid // UUIDv7 from the app (ADR-009)
  templateId   String @db.Uuid
  questionId   String @db.Uuid
  order        Int
  questionText String

  // Postgres does not auto-index FK-referencing columns; the frozen read
  // path (design.md Decision 5) filters on exactly this column.
  @@index([templateId])
}

// review-session/design.md Decision 8: two values only — `signed` is
// deliberately NOT declared (FR-010's concern, added later by
// `ALTER TYPE ... ADD VALUE`). The TypeScript union in
// `review-session/domain/review-session-status.ts` is authoritative; this
// enum is its persistence projection only, mirroring `ReviewTemplateStatus`'s
// precedent.
enum ReviewSessionStatus {
  draft
  completed
}

// review-session/design.md Decision 9: the TypeScript union in
// `review-session/domain/answer-value.ts` is authoritative; this enum is its
// persistence projection only.
enum AnswerValue {
  YES
  NO
  NOT_APPLICABLE
}

// review-session/design.md Decision 4/8: the aggregate root. NO `deletedAt`
// (design.md Interfaces/Contracts — ADR-010's stricter rule for review
// records, spec.md "Review Records Carry No Deletion Path"). Discarding a
// `draft` is a hard delete (repository.discardDraft), the only removal path
// that exists; a `completed` session is permanently immutable —
// `recordEntry`/`markUnreviewed`/`complete`/`discard` all guard
// `status === 'draft'` at the domain layer (Decision 8).
//
// The FKs to Community(id)/ReviewTemplate(id)/User(id, via performedById)
// are hand-written in migration.sql, INVISIBLE to Prisma (no `@relation`
// here, ADR-013 — mirroring every other cross-module FK in this schema).
//
// review-history-company-scope/design.md Decision 2: performedByCompanyId's
// FK to MaintenanceCompany(id) is ALSO hand-written and Prisma-invisible (no
// `@relation` here either, same ADR-013 convention).
model ReviewSession {
  id            String              @id @db.Uuid // UUIDv7 from the app (ADR-009)
  communityId   String              @db.Uuid
  templateId    String              @db.Uuid // the FROZEN version row — Decision 7
  performedById String              @db.Uuid
  status        ReviewSessionStatus
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  // NO deletedAt — ADR-010's stricter rule for review records (Decision 8)

  // review-history-company-scope/design.md Decision 1/2: the performer's
  // maintenance company, SNAPSHOTTED at session creation and never updated
  // again — no `complete()`/`discardDraft()` write path touches it. Nullable
  // forever (not a closing `SET NOT NULL` step) — a performer with no
  // company is a legitimate, permanent state, not a transient gap. The FK to
  // MaintenanceCompany(id) is hand-written in migration.sql, INVISIBLE to
  // Prisma (no `@relation` here, ADR-013).
  performedByCompanyId String? @db.Uuid

  // Prisma-VISIBLE regular indexes. Postgres does not auto-index
  // FK-referencing columns; both are filtered by the by-community and
  // by-performer read paths.
  @@index([communityId])
  @@index([performedById])
  // review-history-company-scope/design.md Decision 2: filters the
  // manager's company-wide read path.
  @@index([performedByCompanyId])
  // One open draft per (community, template, performer) is a HAND-WRITTEN
  // PARTIAL UNIQUE INDEX — `@@unique` has no `WHERE` clause, so Prisma
  // cannot express it and is therefore INVISIBLE to Prisma's migration
  // diffing (design.md Interfaces/Contracts):
  //   CREATE UNIQUE INDEX "ReviewSession_open_draft_key"
  //     ON "ReviewSession"("communityId","templateId","performedById")
  //     WHERE "status" = 'draft';
}

// review-session/design.md Decision 1: `observations` is the entry's skip
// reason, nullable, NON-NULL iff the element was left unreviewed. Enforced
// at the domain layer (no public constructor — `.reviewed()`/`.unreviewed()`
// factories) and backstopped by a hand-written CHECK constraint below
// (intra-row half only — see migration.sql).
//
// The FK to ReviewSession(id) is hand-written in migration.sql and declares
// `ON DELETE CASCADE` so discarding a draft removes its entries too
// (Interfaces/Contracts, `discardDraft`). The FK to InspectableElement(id)
// is hand-written with the default `ON DELETE RESTRICT` — elements are
// never hard-deleted (ADR-010).
model ElementReviewEntry {
  id                   String   @id @db.Uuid // UUIDv7 from the app (ADR-009)
  reviewSessionId      String   @db.Uuid
  inspectableElementId String   @db.Uuid
  observations         String? // NON-NULL iff unreviewed — Decision 1
  recordedAt           DateTime @default(now())

  @@unique([reviewSessionId, inspectableElementId])
  // Hand-written, Prisma-invisible backstop for the intra-row half of the
  // `answers XOR observations` invariant only — a table CHECK cannot see
  // child rows (design.md Decision 1):
  //   ALTER TABLE "ElementReviewEntry" ADD CONSTRAINT
  //     "ElementReviewEntry_observations_not_blank"
  //     CHECK ("observations" IS NULL OR btrim("observations") <> '');
}

// review-session/design.md Decision 9: `questionId` is provenance only,
// mirroring `ReviewTemplateQuestion.questionId` — the frozen wording lives
// on the template snapshot, not copied here. The FK to
// ElementReviewEntry(id) is hand-written in migration.sql and declares
// `ON DELETE CASCADE`, chained from `ReviewSession`'s own cascade
// (Interfaces/Contracts, `discardDraft`).
model QuestionAnswer {
  id                   String      @id @db.Uuid // UUIDv7 from the app (ADR-009)
  elementReviewEntryId String      @db.Uuid
  questionId           String      @db.Uuid // provenance: ReviewTemplateQuestion.questionId
  answer               AnswerValue

  @@unique([elementReviewEntryId, questionId])
}
