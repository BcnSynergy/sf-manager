// Prisma schema — infrastructure-layer artifact only (ADR-013). Models are
// added per SDD slice, mapped to hand-written domain entities in each
// module's repository implementations, never used directly outside
// infrastructure/persistence/**.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// design.md Decision 4/9: no `@default` — a required column added to a
// non-empty table needs an explicit backfill, not a schema-level default
// that would silently decide every future insert's role too.
enum Role {
  SYSTEM_ADMIN
  MANAGER
  MAINTENANCE_COMPANY_MANAGER
  MAINTENANCE_TECHNICIAN
  COMMUNITY_REPRESENTATIVE
}

model User {
  id           String    @id @db.Uuid // UUIDv7 from the app (ADR-009)
  email        String    @unique // stored lowercase-normalized
  passwordHash String
  role         Role // design.md Decision 9 — no @default, see migration
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // ADR-010
}

// Deny-list, not a session table: only ever holds explicitly logged-out
// tokens until their natural expiry (design.md Decision 9 — minimum viable
// revocation, not general session management).
model RevokedToken {
  jti       String   @id @db.Uuid // the token's own jti claim
  expiresAt DateTime // copied from the token's own exp — safe to delete once past

  // The opportunistic cleanup query (`WHERE expiresAt < now()`) runs on every
  // login/logout, so this must not be a full table scan.
  @@index([expiresAt])
}
