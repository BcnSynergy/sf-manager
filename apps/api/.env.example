# Copy to apps/api/.env (git-ignored) and adjust. Placeholder values only.

# The dev seed (users, communities, sessions, ...) runs ONLY when this is
# exactly "development". Unset or any other value skips it and logs why.
NODE_ENV=development

# Postgres from docker-compose.yml.
DATABASE_URL="postgresql://sfmanager:sfmanager@localhost:5432/sfmanager?schema=public"

# Required: the app throws at boot without these two.
JWT_SECRET="<a long random string>"
CORS_ORIGIN="http://localhost:5173"

# Optional. Access token lifetime (30m, 2h, 1d). Default 2h.
# JWT_EXPIRES_IN="2h"

# Optional. API port. Default 3000.
# PORT=3000

# Used by `prisma db seed` to create or update the admin user.
SEED_ADMIN_EMAIL="admin@sfmanager.local"
SEED_ADMIN_PASSWORD="<a password with 10+ characters, a letter and a digit>"
