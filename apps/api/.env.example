# Copy to apps/api/.env (git-ignored) and adjust. Placeholder values only.

# The dev seed (users, communities, sessions, ...) runs ONLY when this is
# exactly "development". Unset or any other value skips it and logs why.
NODE_ENV=development

# Postgres from docker-compose.yml.
DATABASE_URL="postgresql://sfmanager:sfmanager@localhost:5432/sfmanager?schema=public"

# Required: the app throws at boot without these two.
JWT_SECRET="<a long random string>"
CORS_ORIGIN="http://localhost:5173"

# Optional. Access token lifetime (30m, 2h, 1d). Default 2h.
# JWT_EXPIRES_IN="15m"

# Optional. API port. Default 3000.
# PORT=3000

# Used by `prisma db seed` to create or update the admin user.
SEED_ADMIN_EMAIL="admin@sfmanager.local"
SEED_ADMIN_PASSWORD="<a password with 10+ characters, a letter and a digit>"


# All optional; the values shown are the defaults.

# Access token (JWT) lifetime; the web app refreshes it silently.
JWT_EXPIRES_IN="15m"

# Session ends after this much inactivity (must be > 0).
REFRESH_TOKEN_IDLE_TTL="8h"

# Maximum session lifetime, even when active (must be > 0).
REFRESH_TOKEN_ABSOLUTE_TTL="7d"

# Window in which an already-rotated token is still accepted
# (concurrent tabs). "0s" = strict rotation, no grace.
REFRESH_TOKEN_REUSE_GRACE="10s"

# Path scope of the sf_refresh_token cookie (must start with "/").
REFRESH_TOKEN_COOKIE_PATH="/auth"

# --- Refresh endpoint rate limit ---
# Max refresh requests per client within the window.
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=60
# Window length, in seconds.
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60