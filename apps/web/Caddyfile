# The stack's web server (odd/tasks/deployment.md, S5-S7): one origin for the
# web app and the API. It publishes no port: the edge proxy (deploy/edge)
# owns ports 80 and 443, terminates HTTPS and forwards each request here over
# the sf-edge network on plain HTTP, Host header unchanged
# (odd/tasks/demo-instance.md, T1).
{
	auto_https off
	servers {
		# Only Docker networks reach this server, so every peer is the edge
		# proxy or another container: keep the X-Forwarded-For the edge proxy
		# set and append its address, so the API finds the real client two
		# hops back (TRUST_PROXY=2).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Security headers (EN-94; spec `deployment`, "Security headers").
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# HSTS on a real domain only: on `localhost` it would make the browser
	# refuse plain HTTP for every localhost port, the Vite dev server included.
	# An IP address or a *.localhost name still gets it (browsers ignore HSTS
	# for IPs). No includeSubDomains or preload, so other subdomains stay
	# unaffected. The Host header is the public one, since the edge proxy passes
	# it on. The HTTP->HTTPS redirect gets none of these headers: the edge proxy
	# serves it.
	@hsts not host localhost
	header @hsts Strict-Transport-Security "max-age=31536000"

	# The web app loads everything from its own origin and has no inline
	# script or style. /api/* is left out: its JSON needs no policy, and
	# Swagger UI (API_DOCS_ENABLED) uses inline styles. Vite may inline small
	# assets as data: URLs.
	@web not path /api/*
	header @web Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# The API keeps its routes: /api/auth/login reaches it as /auth/login.
	# The edge proxy replaces any client-sent X-Forwarded-For with the real
	# client address and this server appends the edge proxy's, which is why the
	# API trusts exactly two hops (TRUST_PROXY=2).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Vite names built assets by content hash, so they never change. A missing
	# one (an old tab after an upgrade) must be a real 404, not index.html.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Client-side routes have no file of their own, so they get index.html,
	# which is revalidated on every load so an upgrade reaches open browsers.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
