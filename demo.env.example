# The public demo's settings (docker-compose.demo.yml; README "Demo
# stack"). Copy to demo.env (never committed) and fill in every value:
#   cp demo.env.example demo.env
# Every secret here must differ from production's.

# Public domain of the demo; the edge proxy must serve the same one
# (SFMANAGER_DEMO_SITE in deploy/edge/edge.env).
SITE_ADDRESS=sf-manager-demo.example.com

# The demo's own edge network and web alias, so its web never shares a
# network with the production web (EN-248). Keep these values.
EDGE_NETWORK=sf-edge-demo
WEB_ALIAS=sf-manager-demo-web

# Which published images to run: sha-<first 7 characters of a commit that
# CI published from main>, like IMAGE_TAG in prod.env.
IMAGE_TAG=

# URL-safe, since it is embedded in the database URL:
#   openssl rand -hex 32
POSTGRES_USER=sfmanager
POSTGRES_PASSWORD=
POSTGRES_DB=sfmanager

# Same rules as in prod.env: at least 32 characters each, and different
# from each other.
#   openssl rand -hex 32
JWT_SECRET=
THROTTLE_KEY_SECRET=

# The demo's system admin, seeded again on every reset. Never published:
# the demo's public accounts are the seeded ones (spec `demo-seed-data`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Hour (UTC, 0-23) of the nightly reset.
DEMO_RESET_HOUR_UTC=3
