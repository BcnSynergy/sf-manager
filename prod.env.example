# Copy to prod.env (never committed) and fill in every value.
#   cp prod.env.example prod.env

# Public domain whose DNS points at this server. Caddy obtains its HTTPS
# certificate on its own. `localhost` runs the stack on a developer machine.
SITE_ADDRESS=sf-manager.example.com

# The password is embedded in the database URL, so keep it URL-safe:
#   openssl rand -hex 32
POSTGRES_USER=sfmanager
POSTGRES_PASSWORD=
POSTGRES_DB=sfmanager

# Signs the session tokens. Changing it logs every user out.
#   openssl rand -hex 32
JWT_SECRET=

# Access-token lifetime, default 2h.
JWT_EXPIRES_IN=2h

# Refresh sessions (TD-5): a session ends after this long without use,
# default 8h, and this long after its login whatever the use, default 7d.
REFRESH_TOKEN_IDLE_TTL=8h
REFRESH_TOKEN_ABSOLUTE_TTL=7d

# Serves Swagger UI and the OpenAPI document at /api/docs. They list every
# route and schema to anyone who can reach the site, so keep this false
# unless you need them.
API_DOCS_ENABLED=false

# Days to keep the daily database dumps in ./backups, default 14. Copy them
# off the server as well (README "Database backups").
BACKUP_RETENTION_DAYS=14

# Off-site copies (README "Off-site copies"): set all five to copy ./backups
# every hour, encrypted, to an existing S3-compatible bucket; leave all five
# empty to keep the backups on this server only. Example for Cloudflare R2:
# endpoint https://<account id>.r2.cloudflarestorage.com, provider
# Cloudflare. The key needs read and write access to that bucket only.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Encrypts the copies before they leave the server. Without it they cannot
# be restored: keep a copy of it somewhere other than this server.
#   openssl rand -hex 32
OFFSITE_ENCRYPTION_PASSWORD=
# rclone's S3 provider name (Cloudflare, AWS, Wasabi, ...), default Other,
# and the bucket's region, default auto. auto suits Cloudflare R2 only: for
# any other provider set the bucket's real region (for example eu-central-1),
# or every copy fails its request signature.
OFFSITE_S3_PROVIDER=
OFFSITE_S3_REGION=
