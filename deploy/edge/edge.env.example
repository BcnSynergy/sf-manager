# Edge proxy settings (deploy/edge/docker-compose.yml). Copy to
# deploy/edge/edge.env on the server; edge.env is not committed.

# Public domain of SF-Manager production; it must match SITE_ADDRESS in
# prod.env. Caddy obtains its HTTPS certificate on its own. `localhost` runs
# the edge proxy on a developer machine.
SFMANAGER_SITE=sf-manager.example.com
